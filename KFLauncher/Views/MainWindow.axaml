<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KFLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="680"
        x:Class="KFLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icon.ico"
        Title="KFLauncher"
        Background="#0b0e14"
        Width="920" Height="680" MinWidth="760" MinHeight="560">

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#e6b450"/>
            <Setter Property="Foreground" Value="#1a1200"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#f5cf77"/>
            <Setter Property="Foreground" Value="#1a1200"/>
        </Style>
        <Style Selector="Button.launch">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="52"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#e6b450"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0 3"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 12" ColumnDefinitions="Auto,*">
            <Image Grid.Column="0" Source="/Assets/Logo.png" Height="52" HorizontalAlignment="Left"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="0 10 0 0" Padding="10 6" CornerRadius="6"
                Background="#141a24" BorderBrush="#242c3a" BorderThickness="1"
                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Status}" Foreground="#c7cdd8" TextWrapping="Wrap"/>
        </Border>

        <TabControl>
            <!-- Server browser -->
            <TabItem Header="Servers">
                <DockPanel Margin="0 8 0 0">
                    <!-- shown until a key is saved, the list comes from the steam web api -->
                    <Border DockPanel.Dock="Top" IsVisible="{Binding NeedsServerSource}" Margin="0 0 0 10"
                            Background="#141a24" BorderBrush="#242c3a" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Foreground="#8b93a1" TextWrapping="Wrap"
                                       Text="The server list needs somewhere to come from: either a list url (a host caching the list for everyone, see the README) or a free steam web api key tied to your own account. Either one is remembered."/>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <TextBox Grid.Row="0" Grid.Column="0" Watermark="Server list url" Text="{Binding Config.ServerListUrl}"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Margin="0 8 0 0" Watermark="or a steam web api key" Text="{Binding Config.SteamApiKey}"/>
                                <Button Grid.Row="1" Grid.Column="1" Margin="8 8 0 0" Content="Get a key" Command="{Binding GetApiKeyCommand}"/>
                                <Button Grid.Row="1" Grid.Column="2" Margin="8 8 0 0" Classes="accent" Content="Load servers" Command="{Binding RefreshServersCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0 0 0 8" ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox Grid.Column="0" Watermark="Filter by server name or map" Text="{Binding Filter}"/>
                        <CheckBox Grid.Column="1" Margin="12 0 0 0" IsChecked="{Binding HideEmpty}" Content="Hide empty"/>
                        <CheckBox Grid.Column="2" Margin="12 0 0 0" IsChecked="{Binding HideFull}" Content="Hide full"/>
                        <Button Grid.Column="3" Margin="12 0 0 0" Width="110" Classes="accent" Content="Refresh"
                                Command="{Binding RefreshServersCommand}" IsEnabled="{Binding !IsRefreshing}"/>
                    </Grid>

                    <ProgressBar DockPanel.Dock="Top" Margin="0 0 0 8" Height="2" IsIndeterminate="True"
                                 IsVisible="{Binding IsRefreshing}"/>

                    <DataGrid ItemsSource="{Binding Servers}" IsReadOnly="True" CanUserSortColumns="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              DoubleTapped="OnServerDoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Locked}" SortMemberPath="Passworded" Width="32"/>
                            <DataGridTextColumn Header="Server" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="190"/>
                            <DataGridTextColumn Header="Players" Binding="{Binding Slots}" SortMemberPath="Players" Width="90"/>
                            <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="Ping" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Connect" Classes="accent" Margin="4 3"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[DataGrid].DataContext.ConnectCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Patches / launch -->
            <TabItem Header="Launch">
                <DockPanel Margin="0 8 0 0">
                    <Button DockPanel.Dock="Bottom" Classes="accent launch" Content="Launch Killing Floor"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding StartGameCommand}"/>

                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Detect game path" Width="200" HorizontalContentAlignment="Center"
                                    Command="{Binding DetectConfigCommand}"/>
                            <Button Content="Use recommended" Width="200" HorizontalContentAlignment="Center"
                                    Command="{Binding SetRecommendedCommand}"/>
                            <Button Content="Restore original config files" Width="240" HorizontalContentAlignment="Center"
                                    Command="{Binding RestoreConfigCommand}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="Patches"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0">
                                    <CheckBox IsChecked="{Binding Config.DisableCache}" Content="Disable cache (causes stutters)"/>
                                    <CheckBox IsChecked="{Binding Config.OptimizePerformance}" Content="Optimize performance"/>
                                    <CheckBox IsChecked="{Binding Config.DisableMusic}" Content="Disable music"/>
                                    <CheckBox IsChecked="{Binding Config.SkipIntro}" Content="Skip intro"/>
                                    <CheckBox IsChecked="{Binding Config.QuickHeal}" Content="Bind Q quickheal"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox IsChecked="{Binding Config.IncreaseCacheLimit}" Content="Increase cache limit"/>
                                    <CheckBox IsChecked="{Binding Config.UnlockFramerate}" Content="Unlock framerate"/>
                                    <CheckBox IsChecked="{Binding Config.FixMouseInput}" Content="Fix mouse input"/>
                                    <CheckBox IsChecked="{Binding Config.DisableMovies}" Content="Disable movies"/>
                                    <CheckBox IsChecked="{Binding Config.SetResolution}" Content="Override resolution"/>
                                    <CheckBox IsChecked="{Binding Config.LockMouse}" Content="Lock mouse to game window (proton)"/>
                                    <CheckBox IsChecked="{Binding Config.SetFov}" Content="Override field of view"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="32">
                            <StackPanel IsEnabled="{Binding Config.SetResolution}">
                                <TextBlock Classes="section" Text="Resolution"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="120" Watermark="Width" Text="{Binding Config.ResX}"/>
                                    <TextBlock Text="x" VerticalAlignment="Center"/>
                                    <TextBox Width="120" Watermark="Height" Text="{Binding Config.ResY}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsEnabled="{Binding Config.SetFov}">
                                <TextBlock Classes="section" Text="Field of view"/>
                                <TextBox Width="120" Watermark="85 is stock" Text="{Binding Config.Fov}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="After launching or joining a server"/>
                            <ComboBox Width="360" HorizontalAlignment="Left" SelectedIndex="{Binding Config.AfterLaunch}">
                                <ComboBoxItem>Leave the launcher open (works everywhere)</ComboBoxItem>
                                <ComboBoxItem>Minimize the launcher (not on tiling wms)</ComboBoxItem>
                                <ComboBoxItem>Close the launcher</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="Where the server list comes from"/>
                            <TextBox Watermark="Server list url (leave empty to ask steam directly)" Text="{Binding Config.ServerListUrl}"/>
                            <Grid Margin="0 8 0 0" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" PasswordChar="•" Watermark="Steam web api key, only used without a list url" Text="{Binding Config.SteamApiKey}"/>
                                <Button Grid.Column="1" Margin="8 0 0 0" Width="110" Content="Get a key"
                                        HorizontalContentAlignment="Center" Command="{Binding GetApiKeyCommand}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="Install directory"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Watermark="usually steamapps/common/KillingFloor" Text="{Binding Config.GamePath}"/>
                                <Button Grid.Column="1" Margin="8 0 0 0" Width="110" Content="Browse"
                                        HorizontalContentAlignment="Center" Command="{Binding BrowseCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KFLauncher.ViewModels"
        xmlns:models="using:KFLauncher.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="680"
        x:Class="KFLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icon.ico"
        Title="KFLauncher"
        Background="#0b0e14"
        Width="920" Height="680" MinWidth="760" MinHeight="560">

    <Window.Resources>
        <!-- the same details panel under both server lists, whichever row is selected -->
        <DataTemplate x:Key="ServerDetails" DataType="models:ServerInfo">
            <Grid ColumnDefinitions="340,*">
                <StackPanel Grid.Column="0" Margin="0 0 16 0" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Address}" Foreground="#8b93a1" VerticalAlignment="Center"/>
                        <Button Content="Copy" Padding="10 2"
                                Command="{Binding $parent[Window].DataContext.CopyAddressCommand}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Map}" Foreground="#8b93a1"/>
                        <TextBlock Text="{Binding DifficultyText}" Foreground="#8b93a1"/>
                        <TextBlock Text="{Binding Slots}" Foreground="#8b93a1"/>
                        <TextBlock Text="{Binding PingText}" Foreground="#8b93a1"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" Foreground="#5f6672" FontSize="11"/>
                    <TextBox Watermark="Password, if the server wants one" PasswordChar="&#x2022;"
                             Text="{Binding Password}"/>
                    <Button Classes="accent" Content="Connect" Padding="20 4" HorizontalAlignment="Left"
                            Command="{Binding $parent[Window].DataContext.ConnectCommand}"
                            CommandParameter="{Binding}"/>
                </StackPanel>

                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Margin="0 0 0 6" Foreground="#8b93a1"
                               Text="{Binding $parent[Window].DataContext.PlayersStatus}"/>
                    <DataGrid ItemsSource="{Binding $parent[Window].DataContext.Players}" IsReadOnly="True"
                              CanUserSortColumns="True" MinHeight="60" MaxHeight="150" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="90"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="Time" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#e6b450"/>
            <Setter Property="Foreground" Value="#1a1200"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#f5cf77"/>
            <Setter Property="Foreground" Value="#1a1200"/>
        </Style>
        <Style Selector="Button.launch">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="52"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#e6b450"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0 3"/>
        </Style>
        <!-- a long server name used to wrap to three lines and push the row open, which with a
             narrow window turned into one character per line -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#e6b450"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 12" ColumnDefinitions="Auto,*">
            <Image Grid.Column="0" Source="/Assets/Logo.png" Height="52" HorizontalAlignment="Left"/>
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="0 10 0 0" Padding="10 6" CornerRadius="6"
                Background="#141a24" BorderBrush="#242c3a" BorderThickness="1"
                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Status}" Foreground="#c7cdd8" TextWrapping="Wrap"/>
        </Border>

        <TabControl>
            <!-- Server browser -->
            <TabItem Header="Servers">
                <DockPanel Margin="0 8 0 0">
                    <!-- shown until a key is saved, the list comes from the steam web api -->
                    <Border DockPanel.Dock="Top" IsVisible="{Binding NeedsServerSource}" Margin="0 0 0 10"
                            Background="#141a24" BorderBrush="#242c3a" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Foreground="#8b93a1" TextWrapping="Wrap"
                                       Text="The server list needs somewhere to come from: either a list url (a host caching the list for everyone, see the README) or a free steam web api key tied to your own account. Either one is remembered."/>
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                <TextBox Grid.Row="0" Grid.Column="0" Watermark="Server list url" Text="{Binding Config.ServerListUrl}"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Margin="0 8 0 0" Watermark="or a steam web api key" Text="{Binding Config.SteamApiKey}"/>
                                <Button Grid.Row="1" Grid.Column="1" Margin="8 8 0 0" Content="Get a key" Command="{Binding GetApiKeyCommand}"/>
                                <Button Grid.Row="1" Grid.Column="2" Margin="8 8 0 0" Classes="accent" Content="Load servers" Command="{Binding RefreshServersCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0 0 0 8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBox Grid.Row="0" Grid.Column="0" Watermark="Filter by server name or map" Text="{Binding Filter}"/>
                        <Button Grid.Row="0" Grid.Column="1" Margin="12 0 0 0" Width="110" Classes="accent" Content="Refresh"
                                Command="{Binding RefreshServersCommand}" IsEnabled="{Binding !IsRefreshing}"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 8 0 0"
                                    Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding HideEmpty}" Content="Hide empty"/>
                            <CheckBox IsChecked="{Binding HideFull}" Content="Hide full"/>
                            <CheckBox IsChecked="{Binding Config.DedicatedOnly}" Content="Dedicated only"/>
                            <CheckBox IsChecked="{Binding Config.HideOtherVersions}" Content="Hide other versions"/>
                            <ComboBox Width="150" SelectedIndex="{Binding DifficultyIndex}" VerticalAlignment="Center">
                                <ComboBoxItem>Any difficulty</ComboBoxItem>
                                <ComboBoxItem>Beginner</ComboBoxItem>
                                <ComboBoxItem>Normal</ComboBoxItem>
                                <ComboBoxItem>Hard</ComboBoxItem>
                                <ComboBoxItem>Suicidal</ComboBoxItem>
                                <ComboBoxItem>Hell on Earth</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <ProgressBar DockPanel.Dock="Top" Margin="0 0 0 8" Height="2" IsIndeterminate="True"
                                 IsVisible="{Binding IsRefreshing}"/>

                    <Grid RowDefinitions="4*,Auto">
                        <DataGrid Grid.Row="0" x:Name="ServerGrid" ItemsSource="{Binding Servers}" IsReadOnly="True"
                                  CanUserSortColumns="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                                  RowHeight="34"
                                  SelectedItem="{Binding SelectedServer}"
                                  Sorting="OnServerSorting"
                                  DoubleTapped="OnServerDoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34" SortMemberPath="IsFavorite">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Classes="star" Content="{Binding FavoriteIcon}" ToolTip.Tip="Save to favorites"
                                                    Command="{Binding $parent[DataGrid].DataContext.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- the padlock rides with the name, an empty column of its own was
                                     mostly empty -->
                                <DataGridTemplateColumn Header="Server" Width="*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Margin="0 0 6 0" Text="{Binding Locked}"
                                                           IsVisible="{Binding Passworded}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="170"/>
                                <DataGridTextColumn Header="Difficulty" Binding="{Binding DifficultyText}" SortMemberPath="Difficulty" Width="110"/>
                                <DataGridTextColumn Header="Players" Binding="{Binding Slots}" SortMemberPath="Players" Width="95"/>
                                <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="Ping" Width="70"/>
                                <DataGridTemplateColumn Header="" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Connect" Classes="accent" Margin="4 3"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Command="{Binding $parent[DataGrid].DataContext.ConnectCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- details for the selected row, asked of the server itself, and kept
                             up to date for as long as it stays selected -->
                        <Border Grid.Row="1" Margin="0 10 0 0" Padding="12" CornerRadius="6"
                                Background="#141a24" BorderBrush="#242c3a" BorderThickness="1"
                                IsVisible="{Binding SelectedServer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentControl Content="{Binding SelectedServer}"
                                            ContentTemplate="{StaticResource ServerDetails}"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Saved servers -->
            <TabItem Header="Favorites">
                <DockPanel Margin="0 8 0 0">
                    <Grid DockPanel.Dock="Top" Margin="0 0 0 8" ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Watermark="Add a server by address, e.g. 123.45.67.89:7707" Text="{Binding FavoriteAddress}"/>
                        <Button Grid.Column="1" Margin="8 0 0 0" Width="110" Classes="accent" Content="Add"
                                HorizontalContentAlignment="Center" Command="{Binding AddFavoriteCommand}"/>
                        <Button Grid.Column="2" Margin="8 0 0 0" Width="110" Content="Refresh"
                                HorizontalContentAlignment="Center" Command="{Binding RefreshFavoritesCommand}"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Margin="0 0 0 8" Foreground="#8b93a1" TextWrapping="Wrap"
                               Text="{Binding FavoritesStatus}"/>

                    <Border DockPanel.Dock="Bottom" Margin="0 10 0 0" Padding="12" CornerRadius="6"
                            Background="#141a24" BorderBrush="#242c3a" BorderThickness="1"
                            IsVisible="{Binding SelectedFavorite, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding SelectedFavorite}"
                                        ContentTemplate="{StaticResource ServerDetails}"/>
                    </Border>

                    <DataGrid ItemsSource="{Binding Favorites}" IsReadOnly="True" CanUserSortColumns="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeight="34"
                              SelectedItem="{Binding SelectedFavorite}"
                              DoubleTapped="OnServerDoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Classes="star" Content="{Binding FavoriteIcon}" ToolTip.Tip="Remove from favorites"
                                                Command="{Binding $parent[DataGrid].DataContext.ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Server" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Margin="0 0 6 0" Text="{Binding Locked}"
                                                       IsVisible="{Binding Passworded}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="170"/>
                            <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="160"/>
                            <DataGridTextColumn Header="Players" Binding="{Binding Slots}" SortMemberPath="Players" Width="90"/>
                            <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="Ping" Width="70"/>
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Connect" Classes="accent" Margin="4 3"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[DataGrid].DataContext.ConnectCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Patches / launch -->
            <TabItem Header="Launch">
                <DockPanel Margin="0 8 0 0">
                    <Button DockPanel.Dock="Bottom" Classes="accent launch" Content="Launch Killing Floor"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding StartGameCommand}"/>

                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Detect game path" Width="170" HorizontalContentAlignment="Center"
                                    Command="{Binding DetectConfigCommand}"/>
                            <Button Content="Use recommended" Width="170" HorizontalContentAlignment="Center"
                                    Command="{Binding SetRecommendedCommand}"/>
                            <Button Content="Back up config now" Width="180" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Replaces the backup taken on first launch with the files as they are now"
                                    Command="{Binding BackupConfigCommand}"/>
                            <Button Content="Restore backup" Width="160" HorizontalContentAlignment="Center"
                                    Command="{Binding RestoreConfigCommand}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="Patches"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0">
                                    <CheckBox IsChecked="{Binding Config.DisableCache}" Content="Disable cache (causes stutters)"/>
                                    <CheckBox IsChecked="{Binding Config.OptimizePerformance}" Content="Optimize performance"/>
                                    <CheckBox IsChecked="{Binding Config.DisableMusic}" Content="Disable music"/>
                                    <CheckBox IsChecked="{Binding Config.SkipIntro}" Content="Skip intro"/>
                                    <CheckBox IsChecked="{Binding Config.QuickHeal}" Content="Bind Q quickheal"/>
                                    <CheckBox IsChecked="{Binding Config.BetterAudio}" Content="Better audio (EAX, 3D sound, 64 channels)"/>
                                    <CheckBox IsChecked="{Binding Config.DisableBlur}" Content="Disable the low health blur"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox IsChecked="{Binding Config.IncreaseCacheLimit}" Content="Increase cache limit"/>
                                    <CheckBox IsChecked="{Binding Config.UnlockFramerate}" Content="Unlock framerate"/>
                                    <CheckBox IsChecked="{Binding Config.ImproveNetcode}" Content="Raise net speed (and its caps)"/>
                                    <CheckBox IsChecked="{Binding Config.FixMouseInput}" Content="Fix mouse input"/>
                                    <CheckBox IsChecked="{Binding Config.NoSwitchOnPickup}" Content="Never switch weapon on pickup"/>
                                    <CheckBox IsChecked="{Binding Config.DisableMovies}" Content="Disable movies"/>
                                    <CheckBox IsChecked="{Binding Config.SetResolution}" Content="Override resolution"/>
                                    <CheckBox IsChecked="{Binding Config.LockMouse}" Content="Lock mouse to game window (proton)"/>
                                    <CheckBox IsChecked="{Binding Config.SetFov}" Content="Override field of view"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="32">
                            <StackPanel IsEnabled="{Binding Config.SetResolution}">
                                <TextBlock Classes="section" Text="Resolution"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="120" Watermark="Width" Text="{Binding Config.ResX}"/>
                                    <TextBlock Text="x" VerticalAlignment="Center"/>
                                    <TextBox Width="120" Watermark="Height" Text="{Binding Config.ResY}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsEnabled="{Binding Config.SetFov}">
                                <TextBlock Classes="section" Text="Field of view"/>
                                <TextBox Width="120" Watermark="85 is stock" Text="{Binding Config.Fov}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="After launching or joining a server"/>
                            <ComboBox Width="360" HorizontalAlignment="Left" SelectedIndex="{Binding Config.AfterLaunch}">
                                <ComboBoxItem>Leave the launcher open (works everywhere)</ComboBoxItem>
                                <ComboBoxItem>Minimize the launcher (not on tiling wms)</ComboBoxItem>
                                <ComboBoxItem>Close the launcher</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="Where the server list comes from"/>
                            <TextBox Watermark="Server list url (leave empty to ask steam directly)" Text="{Binding Config.ServerListUrl}"/>
                            <Grid Margin="0 8 0 0" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" PasswordChar="•" Watermark="Steam web api key, only used without a list url" Text="{Binding Config.SteamApiKey}"/>
                                <Button Grid.Column="1" Margin="8 0 0 0" Width="110" Content="Get a key"
                                        HorizontalContentAlignment="Center" Command="{Binding GetApiKeyCommand}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="section" Text="Install directory"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Watermark="usually steamapps/common/KillingFloor" Text="{Binding Config.GamePath}"/>
                                <Button Grid.Column="1" Margin="8 0 0 0" Width="110" Content="Browse"
                                        HorizontalContentAlignment="Center" Command="{Binding BrowseCommand}"/>
                            </Grid>
                            <TextBox Margin="0 8 0 0" Text="{Binding Config.ProtonPrefix}"
                                     Watermark="Wine prefix for the mouse lock, empty finds steams own (compatdata/1250/pfx)"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
